{
  "name": "watcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local worker/migrate.ts",
    "worker": "node --env-file-if-exists=.env.local worker/index.ts",
    "dev:ws": "node --env-file-if-exists=.env.local worker/local-ws.ts"
  },
  "browserslist": "> 1%",
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@vercel/functions": "^3.10.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^10.6.1",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "undici": "^7.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@auth/core": {
      "nodemailer": "$nodemailer"
    }
  }
}
